# Konfigurasi Notifikasi Email Eksternal (SMTP / Nodemailer)
# Untuk pengujian menggunakan Gmail SMTP:
# 1. Aktifkan Verifikasi 2 Langkah (2-Step Verification) pada Akun Google.
# 2. Buat App Password (Sandi Aplikasi) khusus melalui:
#    https://myaccount.google.com/apppasswords
# 3. Masukkan 16 karakter App Password pada SMTP_PASS (tanpa spasi).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email-pengirim@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Sistem Pemantauan Web Sumbawa" <email-pengirim@gmail.com>
EMAIL_TO=admin@sumbawakab.go.id
