{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-detection.local/evaluation/sample.schema.json",
  "title": "Evaluation dataset JSONL records",
  "description": "A line is either a manifest record or an annotation record. Detector predictions are not dataset annotations.",
  "oneOf": [
    { "$ref": "#/$defs/manifestRecord" },
    { "$ref": "#/$defs/annotationRecord" }
  ],
  "$defs": {
    "sampleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "detector": {
      "enum": ["text", "link", "defacement"]
    },
    "label": {
      "enum": ["positive", "negative", "uncertain"]
    },
    "fileReference": {
      "type": "object",
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": { "const": "html" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "manifestRecord": {
      "type": "object",
      "required": [
        "record_type",
        "sample_id",
        "detector",
        "source_type",
        "split",
        "group_id",
        "input",
        "reference",
        "provenance",
        "codebook_version"
      ],
      "properties": {
        "record_type": { "const": "manifest" },
        "sample_id": { "$ref": "#/$defs/sampleId" },
        "detector": { "$ref": "#/$defs/detector" },
        "source_type": { "enum": ["synthetic", "public", "authorized_manual"] },
        "split": { "enum": ["development", "evaluation"] },
        "group_id": { "type": "string", "minLength": 1 },
        "input": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "path", "sha256"],
              "properties": {
                "kind": { "const": "text" },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "url" },
                "value": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "path", "sha256"],
              "properties": {
                "kind": { "const": "html" },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          ]
        },
        "reference": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fileReference" }]
        },
        "provenance": {
          "type": "object",
          "required": [
            "source_reference",
            "license_or_permission",
            "collected_at"
          ],
          "properties": {
            "source_reference": { "type": ["string", "null"] },
            "license_or_permission": { "type": "string", "minLength": 1 },
            "collected_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "codebook_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "detector": { "const": "text" } },
            "required": ["detector"]
          },
          "then": {
            "properties": {
              "input": { "properties": { "kind": { "const": "text" } } },
              "reference": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "detector": { "const": "link" } },
            "required": ["detector"]
          },
          "then": {
            "properties": {
              "input": { "properties": { "kind": { "const": "url" } } },
              "reference": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "detector": { "const": "defacement" } },
            "required": ["detector"]
          },
          "then": {
            "properties": {
              "input": { "properties": { "kind": { "const": "html" } } },
              "reference": { "$ref": "#/$defs/fileReference" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "textGroundTruth": {
      "type": "object",
      "required": ["categories"],
      "properties": {
        "categories": {
          "type": "object",
          "required": ["gambling", "fraud", "pornography"],
          "properties": {
            "gambling": { "$ref": "#/$defs/label" },
            "fraud": { "$ref": "#/$defs/label" },
            "pornography": { "$ref": "#/$defs/label" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "linkGroundTruth": {
      "type": "object",
      "required": ["characteristics"],
      "properties": {
        "characteristics": {
          "type": "object",
          "required": [
            "long_url",
            "many_subdomains",
            "ip_hostname",
            "unusual_hostname",
            "encoded_url_structure",
            "url_credentials",
            "suspicious_path",
            "external_redirect_parameter"
          ],
          "properties": {
            "long_url": { "$ref": "#/$defs/label" },
            "many_subdomains": { "$ref": "#/$defs/label" },
            "ip_hostname": { "$ref": "#/$defs/label" },
            "unusual_hostname": { "$ref": "#/$defs/label" },
            "encoded_url_structure": { "$ref": "#/$defs/label" },
            "url_credentials": { "$ref": "#/$defs/label" },
            "suspicious_path": { "$ref": "#/$defs/label" },
            "external_redirect_parameter": { "$ref": "#/$defs/label" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "defacementGroundTruth": {
      "type": "object",
      "required": ["change_status", "pattern_status"],
      "properties": {
        "change_status": { "enum": ["unchanged", "changed", "uncertain"] },
        "pattern_status": {
          "enum": ["pattern_indication", "no_pattern_indication", "uncertain"]
        }
      },
      "additionalProperties": false
    },
    "annotationRecord": {
      "type": "object",
      "required": [
        "record_type",
        "sample_id",
        "detector",
        "annotator_id",
        "annotation_status",
        "ground_truth",
        "annotation_notes",
        "codebook_version"
      ],
      "properties": {
        "record_type": { "const": "annotation" },
        "sample_id": { "$ref": "#/$defs/sampleId" },
        "detector": { "$ref": "#/$defs/detector" },
        "annotator_id": { "type": "string", "minLength": 1 },
        "annotation_status": { "enum": ["independent", "adjudicated"] },
        "ground_truth": {
          "oneOf": [
            { "$ref": "#/$defs/textGroundTruth" },
            { "$ref": "#/$defs/linkGroundTruth" },
            { "$ref": "#/$defs/defacementGroundTruth" }
          ]
        },
        "annotation_notes": { "type": "string" },
        "codebook_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "detector": { "const": "text" } },
            "required": ["detector"]
          },
          "then": {
            "properties": {
              "ground_truth": { "$ref": "#/$defs/textGroundTruth" }
            }
          }
        },
        {
          "if": {
            "properties": { "detector": { "const": "link" } },
            "required": ["detector"]
          },
          "then": {
            "properties": {
              "ground_truth": { "$ref": "#/$defs/linkGroundTruth" }
            }
          }
        },
        {
          "if": {
            "properties": { "detector": { "const": "defacement" } },
            "required": ["detector"]
          },
          "then": {
            "properties": {
              "ground_truth": { "$ref": "#/$defs/defacementGroundTruth" }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
